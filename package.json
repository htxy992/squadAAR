{
  "name": "squad-aar",
  "version": "0.1.0",
  "private": true,
  "description": "Server-side Squad After-Action-Report (AAR) system with an integrated SquadElo rating system. Parses Squad server logs into an event timeline, reconstructs the round, computes SquadPoints + SquadElo, and serves an interactive map replay.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "gen:sample": "tsx src/tools/generateSampleLog.ts",
    "gen:heightmap": "tsx src/tools/genSampleHeightmap.ts",
    "fetch:maps": "tsx src/tools/fetchMaps.ts",
    "ingest": "tsx src/tools/ingestCli.ts",
    "watch": "tsx src/tools/watchCli.ts",
    "serve": "tsx src/api/server.ts",
    "build:static": "tsx src/tools/buildStatic.ts",
    "demo": "tsx src/tools/demo.ts",
    "ingest:geometry": "tsx src/tools/ingestGeometry.ts",
    "test": "tsx --test tests/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
